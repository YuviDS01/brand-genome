# --- Database ---
DATABASE_URL=postgresql://brandgenome:brandgenome@postgres:5432/brandgenome

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Search provider (mock needs no key; tavily requires SEARCH_API_KEY) ---
# Get a free Tavily key (1,000 credits/mo) at https://app.tavily.com
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# --- Crawler (mock until Step 20) ---
CRAWLER_MODE=mock

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend ---
# Used by the BROWSER (client-side fetches) -- must be reachable from
# wherever the person's browser runs, e.g. http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used by the frontend's server-side (SSR) code ONLY when running inside
# Docker Compose -- the frontend container reaches the backend container via
# its service name, not "localhost". Leave unset for local `npm run dev`.
INTERNAL_API_BASE_URL=http://backend:8000